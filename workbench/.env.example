# ── OpenRouter (obligatoire pour l'IA) ────────────────────────────────
# Clé lue UNIQUEMENT côté serveur. Ne jamais la mettre dans le frontend.
OPENROUTER_API_KEY=

# ── Serveur local ─────────────────────────────────────────────────────
# Par défaut, l'agent n'écoute que sur la boucle locale.
HOST=127.0.0.1
PORT=8787
# Port du serveur d'aperçu (pages HTML des projets, origine isolée)
PREVIEW_PORT=8788

# Jeton d'accès de l'interface. Laisser vide : un jeton aléatoire est
# généré au démarrage et enregistré dans .workbench-token.
# Obligatoire si HOST n'est pas une adresse locale.
WORKBENCH_AUTH_TOKEN=

# Dossier contenant les projets (un sous-dossier = un projet)
WORKSPACE_ROOT=./workspace
# Données internes (sessions, coûts, journaux d'audit)
DATA_DIR=./data

# ── Recherche web (optionnel) ─────────────────────────────────────────
# Sans clé Brave, web.search utilise le plugin web d'OpenRouter.
BRAVE_API_KEY=

# ── Navigateur ────────────────────────────────────────────────────────
# chromium | firefox | webkit (les moteurs doivent être installés via
# `npx playwright install <moteur>`)
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=true
