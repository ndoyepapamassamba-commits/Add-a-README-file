{
  "name": "openrouter-ai-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "MASSAMBA Workbench — AI engineering command center: agent loop, tools (files, terminal, browser, data), OpenRouter LLM layer.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "vite build && vite build -c vite.direct.config.ts && node scripts/copy-standalone.mjs",
    "build:direct": "vite build -c vite.direct.config.ts && node scripts/copy-standalone.mjs",
    "dev:direct": "vite -c vite.direct.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "sync:intel": "tsx scripts/sync-intel.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "cross-env OPENROUTER_LIVE=1 vitest run tests/live"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/three": "^0.186.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "ignore": "^7.0.12",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "papaparse": "^5.7.0",
    "playwright": "1.56.1",
    "three": "^0.186.1",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
