 "phrases": [
  {
   "id": "p01",
   "en": "Good evening, do you have a reservation?",
   "fr": "Bonsoir, avez-vous réservé ?",
   "pron": "goud IIV-ning, dou you hav eu rè-zeur-VÉÏ-cheunn ?",
   "trou": "reservation"
  },
  {
   "id": "p02",
   "en": "A table for two, please.",
   "fr": "Une table pour deux, s'il vous plaît.",
   "pron": "eu TÉÏ-beul fôr tou, pliiz.",
   "trou": "table"
  },
  {
   "id": "p03",
   "en": "Here is the menu.",
   "fr": "Voici la carte.",
   "pron": "hieur iz dheu MÈ-nyou.",
   "trou": "menu"
  },
  {
   "id": "p04",
   "en": "Are you ready to order?",
   "fr": "Êtes-vous prêts à commander ?",
   "pron": "âr you RÈ-di tou ÔR-deur ?",
   "trou": "order"
  },
  {
   "id": "p05",
   "en": "What would you like to drink?",
   "fr": "Que voulez-vous boire ?",
   "pron": "wot woud you laïk tou dringk ?",
   "trou": "drink"
  },
  {
   "id": "p06",
   "en": "I recommend the thieboudienne, our fish and rice dish.",
   "fr": "Je vous conseille le thiéboudienne, notre plat de riz au poisson.",
   "pron": "aï rè-keu-MÈND dheu tchè-bou-DJÈNN, aoueur fich annd raïss dich.",
   "trou": "recommend"
  },
  {
   "id": "p07",
   "en": "The chicken yassa is very popular.",
   "fr": "Le poulet yassa est très apprécié.",
   "pron": "dheu TCHI-kinn YA-sa iz VÈ-ri PO-pyou-leur.",
   "trou": "popular"
  },
  {
   "id": "p08",
   "en": "Is it spicy?",
   "fr": "Est-ce que c'est épicé ?",
   "pron": "iz it SPAÏ-si ?",
   "trou": "spicy"
  },
  {
   "id": "p09",
   "en": "Do you have any allergies?",
   "fr": "Avez-vous des allergies ?",
   "pron": "dou you hav È-ni A-leur-djiz ?",
   "trou": "allergies"
  },
  {
   "id": "p10",
   "en": "We have a vegetarian dish.",
   "fr": "Nous avons un plat végétarien.",
   "pron": "wi hav eu vè-dji-TÈ-ri-eunn dich.",
   "trou": "vegetarian"
  },
  {
   "id": "p11",
   "en": "Would you like your fish grilled or fried?",
   "fr": "Voulez-vous votre poisson grillé ou frit ?",
   "pron": "woud you laïk yôr fich grild ôr fraïd ?",
   "trou": "grilled"
  },
  {
   "id": "p12",
   "en": "Your meal will be ready in fifteen minutes.",
   "fr": "Votre repas sera prêt dans quinze minutes.",
   "pron": "yôr miil wil bi RÈ-di inn fif-TIIN MI-nits.",
   "trou": "ready"
  },
  {
   "id": "p13",
   "en": "Enjoy your meal!",
   "fr": "Bon appétit !",
   "pron": "inn-DJOÏ yôr miil !",
   "trou": "meal"
  },
  {
   "id": "p14",
   "en": "Is everything all right?",
   "fr": "Tout se passe bien ?",
   "pron": "iz ÈV-ri-thing ôl raït ?",
   "trou": "everything"
  },
  {
   "id": "p15",
   "en": "Would you like some more bread?",
   "fr": "Voulez-vous encore du pain ?",
   "pron": "woud you laïk seum môr brèd ?",
   "trou": "bread"
  },
  {
   "id": "p16",
   "en": "Can I bring you a dessert?",
   "fr": "Puis-je vous apporter un dessert ?",
   "pron": "kann aï bring you eu di-ZEURT ?",
   "trou": "dessert"
  },
  {
   "id": "p17",
   "en": "We have fresh mango juice.",
   "fr": "Nous avons du jus de mangue frais.",
   "pron": "wi hav frèch MANG-gô djouss.",
   "trou": "juice"
  },
  {
   "id": "p18",
   "en": "Sorry, we have no more fish today.",
   "fr": "Désolé, nous n'avons plus de poisson aujourd'hui.",
   "pron": "SO-ri, wi hav nô môr fich teu-DÉÏ.",
   "trou": "fish"
  },
  {
   "id": "p19",
   "en": "Here is the bill.",
   "fr": "Voici l'addition.",
   "pron": "hieur iz dheu bil.",
   "trou": "bill"
  },
  {
   "id": "p20",
   "en": "Service is not included.",
   "fr": "Le service n'est pas compris.",
   "pron": "SEUR-viss iz not inn-KLOU-did.",
   "trou": "included"
  },
  {
   "id": "p21",
   "en": "Is it to eat in or takeaway?",
   "fr": "C'est sur place ou à emporter ?",
   "pron": "iz it tou iit inn ôr TÉÏK-eu-wéï ?",
   "trou": "takeaway"
  },
  {
   "id": "p22",
   "en": "Please wash your hands before cooking.",
   "fr": "Lavez-vous les mains avant de cuisiner.",
   "pron": "pliiz woch yôr hanndz bi-FÔR KOU-king.",
   "trou": "hands"
  },
  {
   "id": "p23",
   "en": "Keep the meat in the fridge.",
   "fr": "Gardez la viande au réfrigérateur.",
   "pron": "kiip dheu miit inn dheu fridj.",
   "trou": "fridge"
  },
  {
   "id": "p24",
   "en": "The kitchen closes at eleven.",
   "fr": "La cuisine ferme à vingt-trois heures.",
   "pron": "dheu KI-tchinn KLÔ-ziz at i-LÈ-veunn.",
   "trou": "kitchen"
  },
  {
   "id": "p25",
   "en": "Thank you, see you soon!",
   "fr": "Merci, à bientôt !",
   "pron": "thangk you, sii you soun !",
   "trou": "soon"
  }
 ]
