 "phrases": [
  {
   "id": "p01",
   "en": "What is the problem with your car?",
   "fr": "Quel est le problème avec votre voiture ?",
   "pron": "wot iz dheu PRO-bleum widh yôr kâr ?",
   "trou": "problem"
  },
  {
   "id": "p02",
   "en": "The car does not start.",
   "fr": "La voiture ne démarre pas.",
   "pron": "dheu kâr deuz not stârt.",
   "trou": "start"
  },
  {
   "id": "p03",
   "en": "I think the battery is flat.",
   "fr": "Je pense que la batterie est à plat.",
   "pron": "aï thingk dheu BA-teu-ri iz flat.",
   "trou": "battery"
  },
  {
   "id": "p04",
   "en": "I will check the engine.",
   "fr": "Je vais vérifier le moteur.",
   "pron": "aï wil tchèk dhi ÈNN-djinn.",
   "trou": "engine"
  },
  {
   "id": "p05",
   "en": "You have a puncture.",
   "fr": "Vous avez une crevaison.",
   "pron": "you hav eu PEUNGK-tcheur.",
   "trou": "puncture"
  },
  {
   "id": "p06",
   "en": "The front tyre is worn.",
   "fr": "Le pneu avant est usé.",
   "pron": "dheu freunnt TAÏ-eur iz wôrn.",
   "trou": "worn"
  },
  {
   "id": "p07",
   "en": "The brakes make a noise.",
   "fr": "Les freins font du bruit.",
   "pron": "dheu bréïks méïk eu noïz.",
   "trou": "noise"
  },
  {
   "id": "p08",
   "en": "We need to change the brake pads.",
   "fr": "Il faut changer les plaquettes de frein.",
   "pron": "wi niid tou tchéïndj dheu BRÉÏK padz.",
   "trou": "pads"
  },
  {
   "id": "p09",
   "en": "There is an oil leak.",
   "fr": "Il y a une fuite d'huile.",
   "pron": "dhèr iz eunn oïl liik.",
   "trou": "leak"
  },
  {
   "id": "p10",
   "en": "The engine is too hot.",
   "fr": "Le moteur chauffe trop.",
   "pron": "dhi ÈNN-djinn iz tou hot.",
   "trou": "hot"
  },
  {
   "id": "p11",
   "en": "Do not open the radiator when it is hot.",
