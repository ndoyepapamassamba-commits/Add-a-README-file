 "phrases": [
  {
   "id": "p01",
   "en": "The boats leave at five in the morning.",
   "fr": "Les bateaux partent à cinq heures du matin.",
   "pron": "dheu bôts liiv at faïv inn dheu MÔR-ning.",
   "trou": "leave"
  },
  {
   "id": "p02",
   "en": "The sea is rough today.",
   "fr": "La mer est agitée aujourd'hui.",
   "pron": "dheu sii iz reuf teu-DÉÏ.",
   "trou": "rough"
  },
  {
   "id": "p03",
   "en": "Check the weather before you go out.",
   "fr": "Regardez la météo avant de sortir en mer.",
   "pron": "tchèk dheu WÈ-dheur bi-FÔR you gô aout.",
   "trou": "weather"
  },
  {
   "id": "p04",
   "en": "Always wear your life jacket.",
   "fr": "Portez toujours votre gilet de sauvetage.",
   "pron": "ÔL-wéïz wèr yôr LAÏF DJA-kit.",
   "trou": "jacket"
  },
  {
   "id": "p05",
   "en": "There is a storm coming.",
   "fr": "Une tempête arrive.",
   "pron": "dhèr iz eu stôrm KEU-ming.",
   "trou": "storm"
  },
  {
   "id": "p06",
   "en": "Pull the net slowly.",
   "fr": "Tirez le filet doucement.",
   "pron": "poul dheu nèt SLÔ-li.",
   "trou": "net"
  },
  {
   "id": "p07",
   "en": "We had a good catch today.",
   "fr": "Nous avons fait une bonne pêche aujourd'hui.",
   "pron": "wi had eu goud katch teu-DÉÏ.",
   "trou": "catch"
  },
  {
   "id": "p08",
   "en": "Put the fish on ice.",
   "fr": "Mettez le poisson dans la glace.",
   "pron": "pout dheu fich onn aïss.",
   "trou": "ice"
  },
  {
   "id": "p09",
   "en": "How much does this box weigh?",
   "fr": "Combien pèse cette caisse ?",
   "pron": "haou meutch deuz dhiss boks wéï ?",
   "trou": "weigh"
  },
  {
   "id": "p10",
   "en": "This box weighs twenty kilos.",
   "fr": "Cette caisse pèse vingt kilos.",
   "pron": "dhiss boks wéïz TWÈNN-ti KII-lôz.",
   "trou": "kilos"
  },
  {
   "id": "p11",
   "en": "The fish is very fresh.",
   "fr": "Le poisson est très frais.",
   "pron": "dheu fich iz VÈ-ri frèch.",
   "trou": "fresh"
  },
  {
   "id": "p12",
   "en": "What is the price per kilo?",
   "fr": "Quel est le prix au kilo ?",
   "pron": "wot iz dheu praïss peur KII-lô ?",
   "trou": "price"
  },
  {
   "id": "p13",
   "en": "We sell tuna, sardines and shrimps.",
   "fr": "Nous vendons du thon, des sardines et des crevettes.",
   "pron": "wi sèl TYOU-neu, sâr-DIINZ annd chrimps.",
   "trou": "sardines"
  },
  {
   "id": "p14",
   "en": "Help me unload the boat.",
   "fr": "Aidez-moi à décharger le bateau.",
   "pron": "hèlp mi eunn-LÔD dheu bôt.",
   "trou": "unload"
  },
  {
   "id": "p15",
   "en": "Tie the rope to the dock.",
   "fr": "Attachez la corde au quai.",
   "pron": "taï dheu rôp tou dheu dok.",
   "trou": "rope"
  },
  {
   "id": "p16",
   "en": "The ship arrives tomorrow morning.",
   "fr": "Le navire arrive demain matin.",
   "pron": "dheu chip eu-RAÏVZ teu-MO-rô MÔR-ning.",
   "trou": "ship"
  },
  {
   "id": "p17",
   "en": "The crane will load the containers.",
   "fr": "La grue va charger les conteneurs.",
   "pron": "dheu kréïnn wil lôd dheu keunn-TÉÏ-neurz.",
   "trou": "crane"
  },
  {
   "id": "p18",
   "en": "The cargo is in the warehouse.",
   "fr": "La cargaison est dans l'entrepôt.",
   "pron": "dheu KÂR-gô iz inn dheu WÈR-haouss.",
   "trou": "warehouse"
  },
  {
   "id": "p19",
   "en": "Customs must check the papers.",
   "fr": "La douane doit vérifier les papiers.",
   "pron": "KEUSS-teumz meust tchèk dheu PÉÏ-peurz.",
   "trou": "papers"
  },
  {
   "id": "p20",
   "en": "The engine needs more fuel.",
   "fr": "Le moteur a besoin de plus de carburant.",
   "pron": "dhi ÈNN-djinn niidz môr FYOU-eul.",
   "trou": "fuel"
  },
  {
   "id": "p21",
   "en": "The captain gives the orders.",
   "fr": "Le capitaine donne les ordres.",
   "pron": "dheu KAP-tinn guivz dhi ÔR-deurz.",
   "trou": "captain"
  },
  {
   "id": "p22",
   "en": "Stay away from the crane.",
   "fr": "Éloignez-vous de la grue.",
   "pron": "stéï eu-WÉÏ freum dheu kréïnn.",
   "trou": "away"
  },
  {
   "id": "p23",
   "en": "The tide is high now.",
   "fr": "La marée est haute maintenant.",
   "pron": "dheu taïd iz haï naou.",
   "trou": "tide"
  },
  {
   "id": "p24",
   "en": "Keep the frozen fish in the cold room.",
   "fr": "Gardez le poisson congelé dans la chambre froide.",
   "pron": "kiip dheu FRÔ-zeunn fich inn dheu KÔLD roum.",
   "trou": "frozen"
  },
  {
   "id": "p25",
   "en": "The sea is calm, we can go.",
   "fr": "La mer est calme, nous pouvons partir.",
   "pron": "dheu sii iz kâm, wi kann gô.",
   "trou": "calm"
  }
 ]
}
