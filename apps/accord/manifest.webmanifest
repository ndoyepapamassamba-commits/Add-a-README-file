{
  "id": "./",
  "name": "AccordAI",
  "short_name": "AccordAI",
  "description": "Le carnet des accords commerciaux : ce qui a été convenu, confirmé par les deux parties, daté et imprimable en PDF.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f7f5",
  "theme_color": "#0b6e4f",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouvel accord", "short_name": "Nouveau", "url": "./#/nouveau", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "lien",
      "files": [{ "name": "fichiers", "accept": ["text/plain", ".txt", "application/zip", ".zip", "image/jpeg", "image/png", "image/webp", "image/*"] }]
    }
  }
}
