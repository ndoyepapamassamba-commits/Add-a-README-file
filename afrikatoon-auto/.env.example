# --- Écriture des sketchs (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Images + animation (fal.ai donne accès à Veo 3, Grok Imagine, Kling, Nano Banana) — https://fal.ai
FAL_KEY=
# veo3 (audio natif, 8 s/clip) | grok (Grok Imagine) | kling
VIDEO_PRESET=veo3
# Durée totale visée (> 60 s pour Creator Rewards)
TARGET_SECONDS=64

# --- TikTok (app créée sur https://developers.tiktok.com, produit « Content Posting API »)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Rempli automatiquement par `python run.py auth` (à copier dans les secrets GitHub)
TIKTOK_REFRESH_TOKEN=
# draft = la vidéo arrive dans vos brouillons TikTok, vous appuyez sur Publier (recommandé)
# direct = publication automatique (publique seulement si votre app TikTok a passé l'audit)
TIKTOK_MODE=draft
