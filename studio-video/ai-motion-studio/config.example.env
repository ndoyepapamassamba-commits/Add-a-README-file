# MASSAMBA AI MOTION STUDIO — exemple de configuration du serveur local (AUCUN secret ici).
# Copiez ce fichier en « .env » à côté de index.html, puis remplissez seulement ce dont vous avez besoin.
# Le fichier .env n'est jamais versionné (.gitignore) et n'est jamais servi au navigateur (le serveur le bloque).

# ---- serveur
PORT=8787
# HOTE=127.0.0.1            # le serveur n'écoute que sur cette machine
# DONNEES_DIR=              # dossier des vidéos rapatriées (défaut : serveur/donnees)
RETENTION_HEURES=24         # les vidéos rapatriées sont effacées après ce délai

# ---- voies payantes : FERMÉES par défaut (consigne « rien de payant »)
PAYANT_AUTORISE=0           # 1 = autoriser ; chaque génération payante demande en plus une confirmation dans l'app
PLAFOND_TACHES_PAYANTES_JOUR=5   # plafond DUR appliqué par le serveur, même si PAYANT_AUTORISE=1

# ---- fal.ai (clé dans votre tableau de bord fal)
FAL_KEY=
FAL_MODELE_I2V=             # identifiant du modèle fal image → vidéo, lu sur sa page
FAL_MODELE_T2V=             # identifiant du modèle fal texte → vidéo

# ---- Replicate
REPLICATE_API_TOKEN=
REPLICATE_MODELE=           # propriétaire/modèle ; le serveur relit son schéma d'entrée avant chaque envoi

# ---- Runway (API développeur)
RUNWAYML_API_SECRET=

# ---- Luma
LUMAAI_API_KEY=

# ---- Kling (API officielle — adresse et modèle À CONFIRMER dans votre console Kling)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=
KLING_MODELE=

# ---- moteur V1 de la troupe (local, gratuit)
MASSAMBA_BIBLIO=            # dossier de la bibliothèque de la troupe (scènes préparées, fiches, voix)
# MOTEUR_V1_DIR=            # défaut : ../moteur-troupe
# PYTHON=python3
PIPER_VOICES=               # dossier des voix Piper (siwis, gilles) pour la voix off locale
